{
  "build": "wayfinder-desktop/0.5.0-preview.4",
  "scope": "read_only_connections_candidate",
  "connected": [
    {
      "feature": "spaces",
      "backend": "wayfinder/service.py",
      "operations": [
        "spaces",
        "create_space"
      ],
      "scope": "owned persistent spaces"
    },
    {
      "feature": "memory_evidence",
      "backend": "wayfinder/service.py",
      "operations": [
        "inventory",
        "source",
        "recall"
      ],
      "scope": "current/historical scoped evidence; source inspection"
    },
    {
      "feature": "memory_events",
      "backend": "wayfinder/platform/memory_control.py",
      "operations": [
        "platform_memory_propose",
        "platform_memory_result",
        "platform_memory_decide",
        "platform_memory_revoke",
        "platform_memory_reconcile",
        "platform_memory_audit"
      ],
      "scope": "fact proposals and selected-claim correction/retraction through trusted review"
    },
    {
      "feature": "scoped_files",
      "backend": "wayfinder/workers/files.py",
      "operations": [
        "worker_grant",
        "worker_search",
        "worker_revoke"
      ],
      "scope": "trusted picker paths only, bounded discovery"
    },
    {
      "feature": "document_analysis",
      "backend": "wayfinder/workers/hub.py",
      "operations": [
        "worker_start",
        "worker_result",
        "worker_cancel",
        "worker_jobs",
        "worker_forget"
      ],
      "scope": "W35 only; requires fresh runtime qualification and native disclosure consent"
    },
    {
      "feature": "fixed_comparison",
      "backend": "wayfinder/platform/service.py",
      "operations": [
        "platform_read_start",
        "platform_read_result",
        "platform_read_cancel",
        "platform_audit"
      ],
      "scope": "one existing document-plus-memory recipe; ContextGateway/Atlas reused internally"
    },
    {
      "feature": "workflow_review",
      "backend": "wayfinder/platform/evaluation.py",
      "operations": [
        "platform_read_retry",
        "platform_read_clear",
        "platform_workflow_evaluate",
        "platform_workflow_metrics"
      ],
      "scope": "explicit read retry with fresh disclosure; historical artifact checks; bounded clearing"
    },
    {
      "feature": "local_branch",
      "backend": "wayfinder/platform/connectors.py",
      "operations": [
        "platform_git_grant",
        "platform_git_observe",
        "platform_git_propose",
        "platform_action_result",
        "platform_action_decide",
        "platform_action_revoke",
        "platform_action_reconcile",
        "platform_action_audit",
        "platform_git_revoke"
      ],
      "scope": "new local codex/ branch only; native exact confirmation"
    },
    {
      "feature": "local_activity_csv",
      "backend": "wayfinder/platform/activity.py",
      "operations": [
        "platform_activity_read"
      ],
      "scope": "canonical selected local CSV only; no fitness provider"
    },
    {
      "feature": "discovery",
      "backend": "wayfinder/platform/runtime.py and catalog.py",
      "operations": [
        "platform_inspect",
        "platform_capabilities"
      ],
      "scope": "actual inspection plus non-authoritative candidates"
    },
    {
      "feature": "settings",
      "backend": "wayfinder/service.py",
      "operations": [
        "settings"
      ],
      "scope": "reading size; background always false"
    },
    {
      "feature": "google_setup_status",
      "backend": "wayfinder/platform/google_read.py",
      "operations": [
        "platform_google_status"
      ],
      "scope": "configuration presence only; live_qualified remains false"
    },
    {
      "feature": "task_profiles",
      "backend": "wayfinder/platform/task_profiles.py",
      "operations": [
        "platform_profiles",
        "platform_profile_start",
        "platform_profile_result",
        "platform_profile_runs",
        "platform_profile_cancel",
        "platform_profile_clear"
      ],
      "scope": "M00 routing, A01-A08/P01-P06 metadata; A01/A05/A06 selected UTF-8 file adapter only; provider task presets and Fitness unavailable; manual read-only connections are separate"
    },
    {
      "feature": "general_chat",
      "backend": "wayfinder/chat.py",
      "operations": [
        "chat_list",
        "chat_new",
        "chat_get",
        "chat_send",
        "chat_cancel",
        "chat_lookup",
        "chat_delete"
      ],
      "scope": "Explicitly approved managed model; canonical bounded history; no automatic memory writes or tools."
    },
    {
      "feature": "read_only_connections",
      "backend": "wayfinder/platform/connections.py",
      "operations": [
        "platform_connections_status",
        "platform_connections_check",
        "platform_external_grant",
        "platform_external_read",
        "platform_external_revoke"
      ],
      "scope": "Imported Windows-account-encrypted credentials; owner/space/task grants; no account writes, automatic memory or model disclosure."
    }
  ],
  "excluded": [
    {
      "feature": "tasks_and_sync",
      "reason": "No completed Wayfinder WorkItem/two-way synchronization service or qualified Hermes Kanban scope/approval adapter."
    },
    {
      "feature": "workflow_builder_scheduler",
      "reason": "Only one fixed recipe is complete; arbitrary templates and trusted recurrence/background lifecycle unqualified."
    },
    {
      "feature": "agent_skill_edits",
      "reason": "Full role/binding reconciliation and publish/rollback enforcement unfinished."
    },
    {
      "feature": "W33_W36_W37",
      "reason": "Excluded image/planning/native surfaces; native execution not qualified or re-enabled."
    },
    {
      "feature": "global_forget_maintenance",
      "reason": "Full cross-copy erasure and store-wide maintenance not complete; retraction and labelled artifact clearing only."
    },
    {
      "feature": "cold_backup_restore_UI",
      "reason": "Existing CLI primitives retained; stopped-runtime UI activation lifecycle not implemented."
    },
    {
      "feature": "hosted_git_and_messaging_fitness",
      "reason": "No qualified hosted write/send/vendor interfaces."
    }
  ],
  "desktop_adapter_additions": [
    "private owned-process bootstrap",
    "named IPC broker and sender validation",
    "main-owned exact confirmation and disclosure",
    "read-only scoped run/action list facade",
    "read-only original retry intent facade",
    "same-family unknown-outcome admission guard"
  ],
  "new_agent_loops": false,
  "new_memory_engine": false,
  "new_scheduler": false,
  "native_testing_enabled": false,
  "schema": "wayfinder.desktop-inclusion/v1",
  "variant": "workspace-parity",
  "version": "0.5.0-preview.4",
