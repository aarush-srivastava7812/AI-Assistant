{
  "name": "wayfinder-desktop",
  "version": "0.5.0-preview.6",
  "private": true,
  "license": "UNLICENSED",
  "description": "Wayfinder GitHub interface connected to the existing scoped application backend",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "backend": "python scripts/freeze-backend.py"
  },
  "build": {
    "appId": "local.wayfinder.desktop",
    "productName": "Wayfinder",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "FEATURES.json",
      "resources/visual-assets.json"
    ],
    "extraResources": [
      {
        "from": ".cache/bundle/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.debug-original",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": ".cache/bundle/backend-project",
        "to": "backend-project",
        "filter": [
          "**/*.py",
          "**/*.json",
          "**/*.yaml",
          "**/*.yml",
          "**/*.toml",
          "!**/snapshot_*.json"
        ]
      },
      {
        "from": ".cache/bundle/models",
        "to": "models"
      },
      {
        "from": "resources/wayfinder.png",
        "to": "wayfinder.png"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "resources/setup",
        "to": "setup"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "resources/wayfinder.ico"
    },
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Wayfinder-${version}-Windows-x64.${ext}",
    "portable": {
      "artifactName": "Wayfinder-${version}-Windows-x64.exe",
      "useZip": false
    },
    "nsis": {
      "artifactName": "Wayfinder-Setup-${version}-Windows-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "resources/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
